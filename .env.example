# Tender Co-Pilot — environment configuration.
# Copy to .env and fill in values. .env is git-ignored; never commit real secrets.

# Database connection string. Leave empty for the default local SQLite file under ./data.
# Postgres example: postgresql://tender:tender@db:5432/tendercopilot
DATABASE_URL=

# API key for the LLM used by agent reasoning / RAG summaries. Empty disables LLM features.
LLM_API_KEY=

# Base URL of an OpenAI-compatible LLM endpoint (used only if LLM_API_KEY is set).
LLM_BASE_URL=https://api.openai.com/v1

# Model name to request from the LLM endpoint.
LLM_MODEL=gpt-4o-mini

# Directory for the ChromaDB vector store (RAG document embeddings).
CHROMA_DIR=./data/chroma

# Hours between automatic ingestion scans of public portals. 0 disables scheduled scans.
INGEST_INTERVAL_HOURS=24

# Comma-separated keywords used by the scheduled ingestion scan.
SCAN_KEYWORDS=road construction,building works,supply

# Set to 1 to disable the background scheduler entirely (ingest manually from the UI).
DISABLE_SCHEDULER=0
